---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
---

<Base title="Tabi - Medication reminders for families">
  <Navbar />
  <main>
    <section class="section">
      <div class="container stack">
        <span class="pill">Medication reminders for iPhone</span>
        <h1>Help your loved ones stay on top of their meds.</h1>
        <p class="lead text-secondary">
          The simple app that reminds them when each dose is due, tracks what's been
          taken, and keeps family and caregivers in the loop.
        </p>
        <p>
          <a class="btn btn-primary" href="#download">Download for iPhone</a>
        </p>
      </div>
    </section>

    <section class="section section-white">
      <div class="container">
        <h2>How Tabi works</h2>
        <div class="grid" style="margin-top: 32px">
          <div class="card" style="background: var(--color-bg)">
            <h3>Scan the label</h3>
            <p class="text-secondary" style="margin-top: 8px">
              Point your camera at the bottle and Tabi fills in the name and dose.
            </p>
          </div>
          <div class="card" style="background: var(--color-bg)">
            <h3>Get a reminder</h3>
            <p class="text-secondary" style="margin-top: 8px">
              When a dose is due, your phone tells you. Tap Take and it's done.
            </p>
          </div>
          <div class="card" style="background: var(--color-bg)">
            <h3>Share with family</h3>
            <p class="text-secondary" style="margin-top: 8px">
              Invite a family member or caregiver to follow along from afar.
            </p>
          </div>
        </div>
      </div>
    </section>

	<section id="download" class="section">
		<div class="container">
			<div class="cta-panel stack">
				<p class="eyebrow"> Download Now</p>
				<h2>Tabi keeps everybody in the loop, so no medication is forgotten.</h2>
				<p>
					<!-- Replace with Apple's official "Download on the App Store" badge and your App Store link -->
					<a class="btn btn-dark" href="#">[App Store badge]</a>
				</p>
			</div>
		</div>
	</section>

	 <!-- The navbar's Contact button scrolls here -->
    <section id="contact" class="section section-white">
      <div class="container stack">
        <p class="eyebrow">Contact</p>
        <h2>Have any questions? Want to stay in the loop?</h2>
 
        <!--
          This form works as-is if the site is hosted on Netlify (Netlify Forms).
          Using another host? Sign up for a form service such as Formspree, put its
          URL in action="", and remove data-netlify and netlify-honeypot.
        -->
        <form
          class="form"
          name="contact"
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <!-- Hidden trap for spam bots. People never see or fill this in. -->
          <p class="visually-hidden">
            <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
 
          <div class="field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />
          </div>
 
          <div class="field">
            <label for="contact-message">
              Message <span class="text-secondary">(optional)</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Ask a question, or leave it blank to get updates about Tabi."
            ></textarea>
          </div>
 
          <button class="btn btn-primary" type="submit">Send</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>